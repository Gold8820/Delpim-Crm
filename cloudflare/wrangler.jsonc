{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Novo Worker (o Worker "delpim-crm", que só encaminha para o Render, continua intacto).
  "name": "sistema-clientes",
  // O código fica na raiz do projeto (src/worker.py, clientes/, templates/), o mesmo do `python run.py`.
  // O build copia para cloudflare/build/ apenas esses arquivos; é essa pasta que vai para o Worker.
  // (Esta pasta cloudflare/ existe porque o pywrangler não aceita um requirements.txt ao lado do
  // pyproject.toml, e o requirements.txt da raiz continua servindo ao `python run.py` e ao Render.)
  "main": "build/worker.py",
  "build": { "command": "node build.mjs", "watch_dir": ["../src", "../clientes", "../templates", "../static"] },
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "preview_urls": false,
  "rules": [
    { "type": "Data", "globs": ["templates/**/*.html"], "fallthrough": false }
  ],
  // Workers Static Assets: CSS e JS (copiados de static/ pelo build) respondidos direto em /static/*,
  // sem passar pelo Python (economiza CPU). Não contêm dados; páginas e APIs exigem login.
  "assets": {
    "directory": "./build/public",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/static/*"]
  },
  // Supabase (conexão Direct) via Hyperdrive. O id é o da configuração criada na Cloudflare.
  // Desenvolvimento local: defina CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
  // apontando para um banco de TESTE (nunca o de produção).
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "2a377c09a7ae4baaad3f27307f560f31" }
  ],
  // Login com Supabase Auth (e-mail e senha), validado no backend. NÃO são segredos: o endereço do projeto e a
  // chave PUBLICÁVEL (sb_publishable_...). A chave service_role nunca é usada nem guardada no Worker.
  "vars": { "SUPABASE_URL": "https://qbsaiaqmhglotnhvrnqd.supabase.co", "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ZWfjEGYSZVy_qGGgUDBDxQ_VPk6ldFD" },
  // Roda o Worker perto do banco (Supabase em AWS us-east-2): cada requisição faz várias consultas,
  // e assim cada ida e volta ao banco leva poucos milissegundos em vez de ~150 ms.
  "placement": { "region": "aws:us-east-2" },
  "observability": { "enabled": true },
  // Ambiente de validação: outro Worker (sistema-clientes-dev.<conta>.workers.dev), mesmo banco e mesmo login.
  // Publicado com `--env dev`; a produção (sistema-clientes) não muda.
  "env": {
    "dev": {
      "name": "sistema-clientes-dev",
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "2a377c09a7ae4baaad3f27307f560f31" }
      ],
      "vars": { "SUPABASE_URL": "https://qbsaiaqmhglotnhvrnqd.supabase.co", "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ZWfjEGYSZVy_qGGgUDBDxQ_VPk6ldFD" }
    }
  }
}
