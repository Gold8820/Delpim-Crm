# Segredos e configuração local (nunca versionar)
.env
.env.*
!.env.example
*.pem
*.key

# Bancos de dados e exportações (dados reais de clientes)
data/
uploads/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Planilhas e arquivos de dados
*.xlsx
*.xls
*.csv

