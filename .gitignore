!tests/fixtures/etapa1.db

# Cloudflare Workers (segredos locais e pacotes gerados pelo pywrangler)
.dev.vars
.dev.vars.*
.wrangler/
python_modules/
.venv-workers/
node_modules/

# Python / ferramentas
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
build/

# Configuração local do editor/assistente
.claude/
